# ============================================================
# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to git.
# ============================================================

# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_free_gemini_api_key_here

# Free-tier Gemini model to use for classification.
# If you hit "model not found" errors on the free tier, try
# an alternative such as gemini-2.0-flash or gemini-flash-latest.
GEMINI_MODEL=gemini-2.5-flash

# Path to Tesseract OCR binary.
# Windows example:  C:\Program Files\Tesseract-OCR\tesseract.exe
# Mac (brew):        /opt/homebrew/bin/tesseract
# Linux (apt):        /usr/bin/tesseract
TESSERACT_CMD=tesseract

# Languages Tesseract should try to read, combined with "+".
# Download the .traineddata files for these into your Tesseract
# "tessdata" folder first (see README). Add/remove based on which
# Indian languages actually appear in your scanned documents.
TESSERACT_LANGUAGES=eng+hin+tel+kan+ori+mar+guj+ben+pan+tam